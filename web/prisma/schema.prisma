generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Configuración por instancia (plantilla white-label). Tabla singleton:
// una sola fila con id fijo "default". El aislamiento entre clientes es el
// despliegue mismo — NO hay tenantId (ver docs/03-spec-plantilla.md).
model SiteSettings {
  id              String   @id @default("default")

  // Identidad
  siteName        String   @default("Mi Catálogo")
  siteDescription String   @default("Catálogo de productos con cotización por WhatsApp.")
  announcement    String?
  logoUrl         String?
  heroImageUrl    String?
  faviconUrl      String?
  ogImageUrl      String?

  // Tema (color base; la rampa 50→700 se deriva en runtime)
  brandColor      String   @default("#64717a")
  brandColorDark  String?

  // Contacto
  whatsappNumber  String   @default("")
  phone           String?
  address         String?
  socialFacebook  String?
  socialInstagram String?
  socialTiktok    String?
  footerTagline   String?

  // Fiscal / legal
  currency        String   @default("PEN")
  locale          String   @default("es-PE")
  country         String   @default("PE")
  priceLabel      String   @default("Precio incluye impuestos")
  priceNote       String   @default("Precio referencial, cotización final por WhatsApp.")
  legalEntity     String?
  legalText       String?

  updatedAt       DateTime @updatedAt
}

model Admin {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  resetToken        String?
  resetTokenExpires DateTime?
  lastActiveAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  name             String
  sku              String?
  slug             String
  description      String?
  // Marca/licencia del producto (ej. "Melissa & Doug"). Requerido por el
  // feed de ChatGPT Shopping y recomendado por Google Merchant — ver
  // src/lib/feeds.ts.
  brand            String?
  // Edad recomendada (años). Habilita guías "por edad" (GEO fase 4) y
  // Product.audience en el JSON-LD — ver src/lib/jsonld.ts.
  ageMin           Int?
  ageMax           Int?
  measure          String?
  gauge            String?
  material         String?
  price            Float          @default(0)
  // Niveles de precio editables por unidad (rollo, metro, ciento, millar…):
  // array JSON de { label: string, amount: number }.
  priceTiers       Json?
  stock            Int            @default(0)
  available        Boolean        @default(true)
  featured         Boolean        @default(false)
  vistas           Int            @default(0)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([categoryId, slug])
  @@index([name])
  @@index([featured])
}

// Preguntas frecuentes editables desde el panel (GEO fase 4: contenido
// citable + FAQPage JSON-LD). Sin categorías/grupos — una lista simple
// ordenada por sortOrder, como pide el prompt (nada de contenido delgado
// ni respuestas duplicadas inventadas por código).
// Campaña activa configurable (GEO fase 4: "fecha límite de pedido" para
// Navidad/temporada; prompt-frontend §4.3: hero de la home). Se muestra la
// campaña cuyo rango [startsAt, endsAt] cubre "ahora" y active=true — ver
// getActiveCampaign() en src/lib/catalog.ts.
model Campaign {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  altText      String
  sortOrder    Int     @default(0)
  pathFull     String
  pathMedium   String
  pathThumb    String
  pathJpegFull String
  createdAt    DateTime @default(now())
}
